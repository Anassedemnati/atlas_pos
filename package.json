{
  "name": "atlas-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas POS: offline Electron touchscreen point of sale for Moroccan small businesses",
  "type": "module",
  "main": "./out/main/index.js",
  "homepage": "https://atlas-pos.local",
  "author": {
    "name": "Atlas POS",
    "email": "contact@atlas-pos.local"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "node scripts/electron-env.mjs dev",
    "preview": "node scripts/electron-env.mjs preview",
    "build": "electron-vite build",
    "boot-check": "node scripts/boot-check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "smoke:linux": "bash scripts/smoke-linux.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "i18next": "^26.5.6",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.3",
    "serialport": "^13.0.0",
    "uuid": "^14.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  }
}
